{
  "version": "2.0",
  "functionTimeout": "00:02:00",
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": true, "excludedTypes": "Request;Exception" } }
  },
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:15",
      "maxPollingInterval": "00:00:02",
      "messageEncoding": "base64"
    }
  },
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" }
}
